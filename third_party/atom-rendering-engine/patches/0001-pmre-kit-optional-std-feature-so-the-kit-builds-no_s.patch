+/// Render `content` in an explicit `face` (e.g. a monospace font the caller parsed), with
+/// the top of its ascent box at `origin`. Same coverage path as `draw_styled`.
+#[allow(clippy::too_many_arguments)]
+pub fn draw_face<S: Surface>(
+    fb: &mut S,
+    face: &font::Font,
+    content: &str,
+    origin: Vec2,
+    size: f32,
+    color: Rgba,
+    clip: Option<Bounds>,
+    underline: bool,
+) {
+    let ascent = face.ascent(size);
+    let baseline = origin.y + ascent;
+    let mut pen = origin.x;
+    for ch in content.chars() {
+        let g = face.raster(ch, size);
+        if g.w > 0 && g.h > 0 {
+            let gx = (pen + 0.5).floor() as i32 + g.left;
+            let gy = (baseline + 0.5).floor() as i32 + g.top;
+            blit(fb, &g, gx, gy, color, clip);
+        }
+        pen += face.advance(ch, size);
+    }
+    if underline && pen > origin.x {
+        let y = (baseline + size * 0.09).round();
+        let th = (size * 0.07).round().max(1.0);
+        rule(fb, origin.x, pen, y, th, color, clip);
+    }
+}

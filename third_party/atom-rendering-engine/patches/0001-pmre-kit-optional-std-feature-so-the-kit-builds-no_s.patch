+/// Install the regular (and optionally bold) face explicitly — for embedded fonts, and
+/// the only font source without `std`. Call before the first text operation; returns
+/// `false` when a face was already chosen (installed or discovered).
+pub fn install(regular: Font, bold: Option<Font>) -> bool {
+    let installed = REGULAR.set(Some(Arc::new(regular))).is_ok();
+    if installed {
+        let _ = BOLD.set(bold.map(Arc::new));
+    }
+    installed

+        let bounds = device_bounds(cmd, fb.width, fb.height, (0, fb.height), clip);
+        let t = cmd.transform;
+        convert_rows(cmd, fb, bounds, aa, |x, y| Vec2::new(x - t.e, y - t.f));
+    }
